{
  "name": "greenbidder",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check:disease": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-disease-logic.mjs",
    "check:model": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-model-contract.mjs",
    "check:service": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-disease-service.mjs",
    "check:preprocess": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-preprocess.mjs",
    "check:quality": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-image-quality.mjs",
    "check:animations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-animations.mjs",
    "check:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-audit.mjs",
    "check:all": "npm run check:disease && npm run check:model && npm run check:service && npm run check:preprocess && npm run check:quality && npm run check:animations && npm run check:audit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@supabase/supabase-js": "^2.103.0",
    "@tamagui/babel-plugin": "^2.0.0-rc.38",
    "@tamagui/config": "^2.0.0-rc.38",
    "@tamagui/lucide-icons-2": "^2.0.0-rc.38",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.16",
    "expo-file-system": "~19.0.21",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "jpeg-js": "^0.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "tamagui": "^2.0.0-rc.38",
    "zod": "^4.3.6"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "^5.9.3"
  }
}
